# =============================================================================
# GOAT single-node deployment
# =============================================================================
# Run ./setup.sh to create .env from this file. It fills the secrets and the
# derived values; re-running it keeps every value already in .env and only
# adds keys that are new in this file.
# =============================================================================

# ---------------------------------------------------------------------------
# Release
# ---------------------------------------------------------------------------
GOAT_VERSION=latest
GOAT_REGISTRY=ghcr.io/plan4better/goat

# ---------------------------------------------------------------------------
# Public address and TLS
# ---------------------------------------------------------------------------
# The URL users type into the browser, without a trailing slash, e.g.
# https://goat.example.org, http://10.0.0.5 or http://10.0.0.5:8080
GOAT_PUBLIC_URL=
# auto     = Let's Encrypt certificate (needs public DNS and port 443; port 80
#            only for the redirect from http://)
# custom   = your own certificate: put cert.pem and key.pem into ./certs
# internal = certificate from Caddy's own CA (browsers warn until it is trusted)
# off      = plain HTTP, for local installs or behind your own TLS load balancer
GOAT_TLS=auto
# Optional contact for Let's Encrypt expiry notices (GOAT_TLS=auto)
GOAT_ACME_EMAIL=
# Addresses allowed to set X-Forwarded-* headers (your load balancer), as
# CIDRs separated by spaces. private_ranges covers the RFC 1918 networks.
GOAT_TRUSTED_PROXIES=private_ranges
# Networks allowed to open the Keycloak admin console under /keycloak/admin
GOAT_ADMIN_ALLOW_CIDRS=0.0.0.0/0 ::/0
# Derived by setup.sh from GOAT_PUBLIC_URL and GOAT_TLS
GOAT_HOSTNAME=
GOAT_NETWORK_ALIAS=
GOAT_SITE_ADDRESS=
GOAT_HTTP_PORT=80
GOAT_HTTPS_PORT=443
GOAT_HTTPS_PUBLISH=443:443
# "none" lets Keycloak log in over plain HTTP from any address (GOAT_TLS=off)
GOAT_KEYCLOAK_SSL_REQUIRED=external
# Extra CA certificate(s) (PEM) the services must trust, e.g. your company CA
# for the certificate of your SMTP relay. The public CAs are always trusted.
# Path inside the containers; the file goes into ./certs. With GOAT_TLS=internal
# setup.sh points this at Caddy's own root CA.
GOAT_CA_BUNDLE=

# ---------------------------------------------------------------------------
# Profiles: the bundled components to run
# ---------------------------------------------------------------------------
# garage   = bundled S3 object storage (leave out to use your own S3, below)
# keycloak = bundled login server (leave out to use your own Keycloak, below)
# backup   = nightly backups into ./backups
COMPOSE_PROFILES=garage,keycloak

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# True = users log in through Keycloak. False = no login at all: everybody acts
# as one built-in administrator. Only for local or demo installs.
AUTH=True
# The first GOAT user, created in the bundled Keycloak on first start
GOAT_ADMIN_EMAIL=
GOAT_ADMIN_PASSWORD=
# Bundled Keycloak: realm and client GOAT uses
REALM_NAME=goat
KEYCLOAK_CLIENT_ID=goat
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# Your own Keycloak instead of the bundled one: remove "keycloak" from
# COMPOSE_PROFILES and set both URLs to it (including a relative path such as
# /keycloak or /auth if your Keycloak uses one), plus REALM_NAME, KEYCLOAK_CLIENT_ID and
# KEYCLOAK_CLIENT_SECRET above.
# KEYCLOAK_PUBLIC_URL=https://login.example.org
# KEYCLOAK_INTERNAL_URL=https://login.example.org
# A realm shared with other applications: list the clients whose tokens GOAT's
# APIs accept, comma-separated (the token's "azp", the client it was issued
# to). It must include KEYCLOAK_CLIENT_ID (core refuses to start otherwise):
# the web app signs users in with it, and the print worker and the services
# pass those tokens on. If only some users may use GOAT, enforce that on
# GOAT's client for every flow it allows, or turn its direct access grants
# off. Unset or empty: tokens of every client of the realm are accepted.
# AUTH_ALLOWED_CLIENTS=goat
# Inviting an email that has no Keycloak account creates the account, and
# Keycloak emails a link to set a password (through the SMTP settings below;
# without them the admin sets the password in the Keycloak admin console).
# false: invitees need an existing account, e.g. when your own Keycloak lets
# people register or signs them in through another identity provider.
# KEYCLOAK_PROVISION_INVITED_USERS=true
# Who may create an organization. true: anyone who signs in without one.
# false: only accounts with the Keycloak realm role "superuser"; everyone else
# waits on a page until they are invited. The bundled realm gives that role to
# nobody: set up your organization before switching this off, or give your
# account the role in the Keycloak admin console.
# ALLOW_ORGANIZATION_CREATION=true

# ---------------------------------------------------------------------------
# Object storage (S3)
# ---------------------------------------------------------------------------
# Bundled Garage: filled by setup.sh. Your own S3 instead: remove "garage" from
# COMPOSE_PROFILES and set the S3_* and ASSETS_* values below.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# S3_ENDPOINT_URL=https://s3.example.org
# S3_PUBLIC_ENDPOINT_URL=https://s3.example.org
# S3_REGION=eu-central-1
# S3_BUCKET_NAME=goat-uploads
# S3_FORCE_PATH_STYLE=true
# Bucket for avatars and images, readable without credentials at ASSETS_URL
# ASSETS_S3_ENDPOINT_URL=https://s3.example.org
# ASSETS_BUCKET_NAME=goat-assets
# ASSETS_URL=https://assets.example.org
# Or, when the store allows no publicly readable bucket, keep the images in
# S3_BUCKET_NAME under assets/ and let core serve them (no assets bucket):
# ASSETS_SERVED_BY_CORE=true
# ASSETS_URL=https://goat.example.org/api/v2/asset/file
# The browser uploads straight to the bucket, so its CORS rules must allow
# PUT with a Content-Type header from GOAT_PUBLIC_URL.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=
WINDMILL_DB_PASSWORD=
# Memory settings for a 16 GB machine; roughly 1/4 and 3/4 of the RAM you
# give Postgres.
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# Jobs (Windmill)
# ---------------------------------------------------------------------------
WINDMILL_ADMIN_PASSWORD=
# Parallel analysis jobs; each tools worker may use up to 4 GB
GOAT_TOOLS_WORKERS=2
# Local port for the Windmill admin UI (bound to 127.0.0.1 only; reach it
# with an SSH tunnel: ssh -L 8110:127.0.0.1:8110 <server>)
WINDMILL_LOCAL_PORT=8110
# Source of the routing and public-transport base data (./base-data.sh)
GOAT_BASE_DATA_URL=https://goat-base-data.plan4better.de/

# ---------------------------------------------------------------------------
# Web app secrets
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# MapTiler key for the satellite/hybrid basemap (hidden when empty)
NEXT_PUBLIC_MAPTILER_KEY=
# Mapbox token for the place search box
NEXT_PUBLIC_MAPBOX_TOKEN=
# Outgoing email (invitations from GOAT, password resets from Keycloak).
# Email is off while SMTP_HOST is empty. Leave SMTP_USER and SMTP_PASSWORD
# empty for a relay that accepts mail without a login.
SMTP_HOST=
SMTP_PORT=587
# starttls = upgrade the connection (usually port 587)
# ssl      = TLS from the first byte (usually port 465)
# none     = no encryption (e.g. an internal relay on port 25)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Sender address; SMTP_USER when empty
SMTP_FROM=
EMAILS_FROM_NAME=GOAT
# Derived by setup.sh from SMTP_SECURITY (Keycloak takes them as two flags)
SMTP_STARTTLS=true
SMTP_SSL=false
# Optional branding for the emails GOAT and Keycloak send: a logo image
# instead of the name, and footer links. EMAIL_CONTACT_URL is also the
# "Contact us" link in the app, EMAIL_PRIVACY_URL the privacy link on the
# login page; both are left out while empty.
# EMAIL_BRAND_NAME=GOAT
# EMAIL_LOGO_URL=https://example.org/logo.png
# EMAIL_CONTACT_URL=https://example.org/contact
# EMAIL_PRIVACY_URL=https://example.org/privacy
# Plan4Better's Odoo (SaaS only). Leave all of these empty unless
# Plan4Better has issued you access to its Odoo. The connection is shared by
# GOAT's Odoo integrations; each has its own key and settings.
# ODOO_URL=
# ODOO_DB=
# Support tickets (Odoo Helpdesk), optional and off by default: the app then
# shows "Report a problem" as an email address plus the documentation. On only
# when ODOO_URL, ODOO_DB, ODOO_SUPPORT_API_KEY (a secret issued by
# Plan4Better) and ODOO_SUPPORT_TEAM_ID are all set. Uploads on
# /api/v2/support take up to 55 MiB per request; the bundled Caddy has no body
# size limit, so keep it that way for this path if you put another proxy in
# front.
# ODOO_SUPPORT_API_KEY=
# ODOO_SUPPORT_TEAM_ID=
# Server action used to post a message as the ticket participant
# ODOO_SUPPORT_POST_ACTION=GOAT: post message as ticket participant
# GOAT data catalog (read-only bucket with the harmonised datasets, and the
# OpenStreetMap and Overture mirror under mirror/ for Add layer › Connect service)
CATALOG_S3_BUCKET=
CATALOG_S3_ENDPOINT_URL=
CATALOG_S3_ACCESS_KEY_ID=
CATALOG_S3_SECRET_ACCESS_KEY=
CATALOG_S3_REGION=
# Geocoding service used by analysis tools
GEOCODING_URL=
GEOCODING_AUTHORIZATION=
# Links and feeds shown in the app. A website that publishes GOAT's blog and
# changelog feeds fills the Home page news; empty = no news section.
NEXT_PUBLIC_WEBSITE_URL=
NEXT_PUBLIC_STATUS_FEED_URL=
NEXT_PUBLIC_DOCS_URL=https://goat.plan4better.de/docs
# Support address of "Report a problem" (while support tickets are off) and of
# the "support unavailable" messages. Empty = support@plan4better.de; set your
# own address for a white-label installation.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Product artwork (icons, default thumbnails, email images) ships with the web
# app and is served under /assets. Set this to serve it from a mirror or CDN.
# STATIC_ASSETS_URL=https://cdn.example.org/goat
# OpenTelemetry export (traces, metrics, logs)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# Backups (profile "backup")
# ---------------------------------------------------------------------------
BACKUP_TIME=02:30
BACKUP_RETENTION_DAYS=7
