{"id": "proj-01", "suite": "project", "context": {"surface": "project.map", "project_id": "00000000-0000-0000-0000-0000000005e1"}, "prompt": "Which layers does this project have?", "critical": true, "checks": [{"kind": "answer", "all_of": ["Radwege", "Bezirke", "Fahrradständer"], "with_shown_items": true}, {"kind": "tools", "called": ["project_get_layers"]}, {"kind": "language", "expected": "en"}]}
{"id": "proj-02", "suite": "project", "context": {"surface": "project.map", "project_id": "00000000-0000-0000-0000-0000000005e1"}, "prompt": "Which fields does the Radwege layer have?", "checks": [{"kind": "answer", "all_of": ["art", "laenge_m", "baujahr", "beleuchtet", "bezirk"]}, {"kind": "language", "expected": "en"}]}
