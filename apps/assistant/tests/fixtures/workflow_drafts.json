            "label": "Erreichbarkeit zu Fuß",
            "settings": {
              "routing_mode": "walking",
              "opportunity_1_max_cost": 15,
              "opportunity_1_n_destinations": 1,
              "opportunity_2_max_cost": 15,
              "opportunity_2_n_destinations": 1
            }
          },
          {
            "id": "save",
            "kind": "export",
            "name": "Nahversorgung",
            "label": "Ergebnis speichern"
          }
        ],
        "connections": [
          {"from": "shops", "to": "heat", "input": "opportunity_layer_1_id"},
          {
