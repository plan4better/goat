    {
      "note": "the spec's example: two datasets, a catchment area, an aggregation and an export, the schools limited to Munich and to one category; a note above the steps that give the result",
      "draft": {
        "name": "Schools: 15-minute walk",
        "steps": [
          {
            "id": "schools",
            "kind": "dataset",
            "label": "Schools",
            "layer": 31,
            "filter": {
              "area": "DE212",
              "where": [
                {
                  "field": "category",
                  "op": "=",
                  "value": "school"
                }
              ]
            }
          },
          {"id": "residents", "kind": "dataset", "layer": 33},
          {
            "id": "walk",
            "kind": "tool",
            "tool": "catchment_area_v2",
            "label": "15 minutes on foot",
            "settings": {
              "routing_mode": "walking",
              "cost_type": "time",
              "max_cost": 15,
              "steps": 1
            }
          },
          {
            "id": "count",
            "kind": "tool",
            "tool": "aggregate_polygon",
            "settings": {
              "area_type": "polygon",
              "column_statistics": [
                {
                  "operation": "sum",
                  "field": "einwohner"
                }
              ],
              "weighted_by_intersecting_area": true
            }
          },
          {"id": "save", "kind": "export", "name": "Residents within 15 minutes"}
        ],
        "connections": [
          {"from": "schools", "to": "walk", "input": "starting_points"},
          {"from": "walk", "to": "count", "input": "area_layer_id"},
          {"from": "residents", "to": "count", "input": "source_layer_id"},
          {"from": "count", "to": "save"}
        ],
        "variables": [],
        "notes": [
          {
            "id": "about",
            "text": "Counts the residents within a 15 minute walk of any school.\n\n- Residents within 15 minutes: one row per separate area of the walk; their sum is the residents within a 15 minute walk of any school, each grid cell by its share inside the walk",
            "near": ["count", "save"]
          }
        ]
      },
