    {
      "note": "a heatmap fed by two datasets, one of them left open, conditions with 'in' and 'contains', and a variable; a blue note beside the workflow",
      "draft": {
        "name": "Nahversorgung zu Fuß",
        "steps": [
          {
            "id": "shops",
            "kind": "dataset",
            "label": "Supermärkte",
            "layer": 34,
            "filter": {
              "where": [
                {
                  "field": "kette",
                  "op": "in",
