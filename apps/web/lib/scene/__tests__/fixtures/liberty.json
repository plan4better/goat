{
  "version": 8,
  "name": null,
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8f4f0"
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "maxzoom": 14,
      "paint": {
        "fill-color": "hsl(35,8%,85%)",
        "fill-outline-color": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          "hsla(35,6%,79%,0.32)",
          14,
          "hsl(35,6%,79%)"
        ]
      }
    },
    {
      "id": "building-3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "filter": ["!", ["has", "hide_3d"]],
      "paint": {
        "fill-extrusion-base": ["get", "render_min_height"],
        "fill-extrusion-color": "hsl(35,8%,85%)",
        "fill-extrusion-height": ["get", "render_height"],
        "fill-extrusion-opacity": 0.8
      }
    }
  ]
}
