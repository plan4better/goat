########################################################################
# ------------ MANDATORY (CHANGE ACCORDING TO YOUR SETUP) ------------#
########################################################################
# Since .env is gitignored, you can use .env.example to build a new `
# .env` file when you clone the repo. This file will be committed
# to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env`
# and populate it with your secrets.
########################################################################

############
#  BASICS  #
############
ENVIRONMENT=dev
# Public URL of the assets bucket (uploaded avatars, logos, images)
ASSETS_URL=http://localhost:9000/goat
# Public URL of the web app. Used by the backend to build links in emails
# (e.g. organization invitations). Must be the real domain in deployments.
CLIENT_URL=http://localhost:3000
# Single auth switch for all services and the web app.
# False = no Keycloak; requests act as the seeded default admin identity.
AUTH=False

############
#  DB      #
############
POSTGRES_SERVER=db
POSTGRES_USER=rds
POSTGRES_PASSWORD=database_password
POSTGRES_PORT=5432
POSTGRES_DB=goat

############
#  WEB     #
############
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_GEOAPI_URL=http://127.0.0.1:8100
NEXT_PUBLIC_PROCESSES_URL=http://127.0.0.1:8300
# STAC API of the catalog service. Unset falls back to ${NEXT_PUBLIC_GEOAPI_URL}/stac,
# which is where the ingress path-routes it in deployed environments.
NEXT_PUBLIC_CATALOG_URL=http://localhost:8400/stac
# Mapbox access token used for the geocoder search control
NEXT_PUBLIC_MAPBOX_TOKEN=
# MapTiler key for the satellite basemap and template preview maps (hidden when empty)
NEXT_PUBLIC_MAPTILER_KEY=
# Product artwork (icons, patterns, default images) ships in apps/web/public/assets
# and is served under /assets; set a base URL to load it from a mirror instead
# NEXT_PUBLIC_ASSETS_URL=https://cdn.example.org/goat
# The docs site
NEXT_PUBLIC_DOCS_URL=https://goat.plan4better.de/docs
# Home: the public website whose blog and GOAT changelog RSS feeds fill "From our
# blog" and "What's new" (fetched by the browser), and the service-status feed
NEXT_PUBLIC_WEBSITE_URL=https://www.plan4better.de
NEXT_PUBLIC_STATUS_FEED_URL=https://status.plan4better.de/goat.json
# Address of "Report a problem" (mailto link) and of the "support unavailable"
# messages. Defaults to support@plan4better.de; set your own address for a
# white-label installation.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.org
# @see: https://next-auth.js.org/providers/keycloak
# NEXTAUTH_URL is the app's public URL; NEXT_PUBLIC_APP_URL is derived from it.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=secret
# The web app's Keycloak issuer and client id are derived from the
# Keycloak section below (KEYCLOAK_SERVER_URL + REALM_NAME, KEYCLOAK_CLIENT_ID).

############
#  S3      #
############
# Assets bucket: the local MinIO, like the data bucket
AWS_S3_ASSETS_BUCKET=goat
ASSETS_S3_ENDPOINT_URL=http://minio:9000
ASSETS_S3_FORCE_PATH_STYLE=True
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_NAME=goat
S3_ENDPOINT_URL=http://minio:9000
# Only needed for local dev: browser needs localhost, but Docker services use minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_PATH=""
S3_PROVIDER=minio
S3_FORCE_PATH_STYLE=True

############
#  Core    #
############
DATA_DIR=/app/data
# Hostname customer domains point their CNAME at; empty turns custom domains off
CUSTOM_DOMAIN_CNAME_TARGET=

############
#  Catalog #
############
# STAC catalog service (apps/catalog, port 8400). Database-less: serves
# ${DATA_DIR}/catalog/mirror_items.parquet + mirror_collections.parquet
# (maintained by the goatlib sync_catalog Windmill task) and nuts.parquet
# (sync_nuts). Reuses AUTH, DATA_DIR and the Keycloak section below; every
# value also accepts a CATALOG_-prefixed override.
# CATALOG_ENABLE_MCP=True
# CATALOG_MCP_ALLOWED_HOSTS=["*"]          # set the real ingress hostname in prod
# CATALOG_CORS_ORIGINS='["http://localhost:3000","http://localhost:3001"]'
#                                          # left unset, defaults to
#                                          # [GOAT_UI_BASE_URL], not ["*"]. Add
#                                          # an entry per web dev-server port.
#                                          # JSON, so keep the outer single
#                                          # quotes (shells that source this
#                                          # file would eat the inner ones).
#                                          # Prefer the CATALOG_ name: bare
#                                          # CORS_ORIGINS also narrows
#                                          # geoapi/processes (both ["*"]).
# Assets (GET /assets/{item_id}/thumbnail|style) and the data preview
# (GET /stac/items/{id}/preview): the routes that read the catalog bucket rather
# than the local mirror. Assets are served out of the private bucket by this
# service -- no public prefix, no signed URLs -- and the harmonised GeoParquet
# has no route at all.
# The route answers 404 until a bucket AND credentials are set: from a client's
# point of view an endpoint this deployment does not offer simply is not there.
#
# Each value falls back to the shared S3_* above, so a deployment whose catalog
# lives in its own object storage needs only the bucket name. Locally it needs
# all of them, because S3_* points at MinIO and the catalog is elsewhere --
# they are read by the catalog service and by the goatlib sync_catalog task
# (Windmill tools worker), so setting them does not move geoapi or core off
# MinIO. Without CATALOG_S3_BUCKET the sync task falls back to S3_BUCKET_NAME,
# which is the uploads bucket and never holds the catalog.
# CATALOG_S3_BUCKET=goat-catalog           # or S3_CATALOG_BUCKET
# CATALOG_S3_ENDPOINT_URL=https://<account>.eu.r2.cloudflarestorage.com
# CATALOG_S3_ACCESS_KEY_ID=
# CATALOG_S3_SECRET_ACCESS_KEY=
# CATALOG_S3_REGION=auto
#
# Where the mirror lives on disk; all default to ${DATA_DIR}/catalog[/...] and
# only need setting when the sync/materialize jobs write somewhere other than
# the DATA_DIR the serving processes see. CATALOG_DATA_DIR is read by the
# catalog service and (read-only) by core; the other two by geoapi.
# CATALOG_DATA_DIR=
# CATALOG_LAYERS_DIR=                       # default ${CATALOG_DATA_DIR}/layers
# CATALOG_TILES_DIR=                        # default ${CATALOG_DATA_DIR}/tiles
# CATALOG_PREVIEW_MAX_FEATURES=100         # ceiling; the byte cap binds first
# CATALOG_PREVIEW_MAX_BYTES=2097152
# CATALOG_PREVIEW_CACHE_DIR=                # unset = NO server-side cache;
#                                          # clients cache via max-age + ETag.
#                                          # Set to a writable *shared* volume
#                                          # to make one render serve all pods
# CATALOG_PREVIEW_CACHE_MAX_BYTES=1073741824  # only used when the dir is set
# CATALOG_PREVIEW_MAX_AGE_SECONDS=86400

############
#  Windmill #
############
# Processes service base URL. Core triggers background jobs through it (layer
# cleanup on folder/bundle delete, bundle imports) — local native dev:
# http://localhost:8300
GOAT_PROCESSES_URL=http://processes:8000
WINDMILL_URL=http://windmill-server:8000
WINDMILL_WORKSPACE=goat
WINDMILL_TOKEN=
# Print worker URL (for rendering report pages via Playwright)
PRINT_BASE_URL=http://goat-dev:3000

############
#  Keycloak #
############
KEYCLOAK_SERVER_URL=
REALM_NAME=
# Single client for web login, core admin enrichment and the print worker.
# Leave unset when AUTH=False.
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Default identity when AUTH=False (dev / self-hosted without Keycloak);
# user + organization are seeded by initial_data
DEFAULT_USER_ID=744e4fd1-685c-495c-8b02-efebce875359
DEFAULT_USER_EMAIL=admin@goat.local
DEFAULT_USER_FIRSTNAME=GOAT
DEFAULT_USER_LASTNAME=Admin
DEFAULT_ORGANIZATION_NAME=GOAT
# Quotas for organizations when no billing is configured (self-hosted)
DEFAULT_QUOTA_STORAGE_MB=1048576
DEFAULT_QUOTA_PROJECTS=10000
DEFAULT_QUOTA_EDITORS=1000
DEFAULT_QUOTA_VIEWERS=1000

############
#  Email (optional) #
############
# Email is sent only when SMTP_HOST is set. SMTP_USER/SMTP_PASSWORD are
# optional (leave empty for a relay without login). SMTP_SECURITY: starttls,
# ssl or none. SMTP_FROM is the sender address (SMTP_USER when empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAILS_FROM_NAME=GOAT
# Email branding: brand name, optional logo image and footer links
EMAIL_BRAND_NAME=GOAT
EMAIL_LOGO_URL=
EMAIL_CONTACT_URL=
EMAIL_PRIVACY_URL=

############
#  Odoo (optional, SaaS only) #
############
# Plan4Better's Odoo; leave unset on self-hosted installs. The connection is
# shared by GOAT's Odoo integrations; each integration has its own key and
# settings under ODOO_<INTEGRATION>_* (see apps/core/src/core/odoo).
# ODOO_URL=https://odoo.example.org
# ODOO_DB=odoo-db
# Support tickets (Odoo Helpdesk), on when the connection and these are set. The
# key is the "GOAT Support Bridge" portal user's (scripts/odoo/support_bridge_setup.py).
# ODOO_SUPPORT_API_KEY=
# ODOO_SUPPORT_TEAM_ID=
# Billing (Odoo subscriptions): shared secret for core's billing/trial webhooks
# (X-Webhook-Secret header). Setting it enables SaaS mode: signups start a
# GOAT-managed trial and the Odoo entitlement push takes over on conversion.
# ODOO_WEBHOOK_SECRET=
# Trial defaults (SaaS mode only); values mirror the GOAT base product.
TRIAL_DAYS=14
TRIAL_QUOTA_STORAGE_MB=5120
TRIAL_QUOTA_PROJECTS=50
TRIAL_QUOTA_EDITORS=3
TRIAL_QUOTA_VIEWERS=2
