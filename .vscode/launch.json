{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Core Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "fastapi",
      "args": [
        "dev",
        "src/core/main.py",
        "--reload",
        "--port",
        "8000"
      ],
      "consoleName": "Core Debug Console",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}/apps/core",
      "justMyCode": false,
      "jinja": true,
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "core-pre-launch",
      "presentation": {
        "hidden": false,
        "group": "backend",
        "order": 3
      }
    },
    {
      "name": "GeoAPI Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "fastapi",
      "args": [
        "dev",
        "src/geoapi/main.py",
        "--reload",
        "--port",
        "8100"
      ],
      "consoleName": "GeoAPI Debug Console",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}/apps/geoapi",
      "justMyCode": false,
      "jinja": true,
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "geoapi-pre-launch",
      "presentation": {
        "hidden": false,
        "group": "backend",
        "order": 3
      }
    },
    {
      "name": "Processes Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "fastapi",
      "args": [
        "dev",
        "src/processes/main.py",
        "--reload",
        "--port",
        "8300"
      ],
      "consoleName": "Processes Debug Console",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}/apps/processes",
      "justMyCode": false,
      "jinja": true,
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "processes-pre-launch",
      "presentation": {
        "hidden": false,
        "group": "backend",
        "order": 3
      }
    },
    {
      "name": "Catalog Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "fastapi",
      "args": [
        "dev",
        "src/catalog/main.py",
        "--reload",
        "--port",
        "8400"
      ],
      "consoleName": "Catalog Debug Console",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}/apps/catalog",
      "justMyCode": false,
      "jinja": true,
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "catalog-pre-launch",
      "presentation": {
        "hidden": false,
        "group": "backend",
        "order": 4
      }
    },
    {
      "name": "Web Debug",
      "type": "node-terminal",
      "request": "launch",
      "envFile": "${workspaceFolder}/.env",
      // `NODE_OPTIONS=` clears the js-debug bootloader that node-terminal
      // injects. With the inspector attached, Turbopack never finishes
      // compiling the heavier routes (`/catalog/[datasetId]`) and the dev
      // server spins until it runs out of memory. Use `pnpm dev:inspect` when
      // the frontend actually needs a debugger (from `apps/web`).
      "command": "NODE_OPTIONS= pnpm run web",
      "preLaunchTask": "web-pre-launch",
      "presentation": {
        "hidden": false,
        "group": "frontend",
        "order": 2
      }
    },
    {
      "name": "Docs Debug",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run --filter @p4b/docs dev",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "docs-pre-launch",
      "presentation": {
        "hidden": false,
        "group": "frontend",
        "order": 2
      }
    },
    {
      "name": "Core (tmux)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tmux new -ADs core 'cd ${workspaceFolder}/apps/core && set -a && . ${workspaceFolder}/.env && set +a && exec uv run fastapi dev src/core/main.py --reload --port 8000'",
      "presentation": {
        "hidden": false,
        "group": "tmux",
        "order": 1
      }
    },
    {
      "name": "GeoAPI (tmux)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tmux new -ADs geoapi 'cd ${workspaceFolder}/apps/geoapi && set -a && . ${workspaceFolder}/.env && set +a && exec uv run fastapi dev src/geoapi/main.py --reload --port 8100'",
      "presentation": {
        "hidden": false,
        "group": "tmux",
        "order": 2
      }
    },
    {
      "name": "Processes (tmux)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tmux new -ADs processes 'cd ${workspaceFolder}/apps/processes && set -a && . ${workspaceFolder}/.env && set +a && exec uv run fastapi dev src/processes/main.py --reload --port 8300'",
      "presentation": {
        "hidden": false,
        "group": "tmux",
        "order": 3
      }
    },
    {
      "name": "Catalog (tmux)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tmux new -ADs catalog 'cd ${workspaceFolder}/apps/catalog && set -a && . ${workspaceFolder}/.env && set +a && exec uv run fastapi dev src/catalog/main.py --reload --port 8400'",
      "presentation": {
        "hidden": false,
        "group": "tmux",
        "order": 4
      }
    },
    {
      "name": "Web (tmux)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tmux new -ADs web 'cd ${workspaceFolder} && set -a && . ${workspaceFolder}/.env && set +a && exec pnpm web'",
      "presentation": {
        "hidden": false,
        "group": "tmux",
        "order": 4
      }
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "jinja": true,
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "uv-sync",
    },
    {
      "name": "Sync Windmill Scripts",
      "type": "debugpy",
      "request": "launch",
      "module": "goatlib.tools.sync_windmill",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "uv-sync",
      "console": "integratedTerminal",
      "presentation": {
        "hidden": false,
        "group": "tools",
        "order": 4
      }
    },
    {
      "name": "Sync Windmill Tasks",
      "type": "debugpy",
      "request": "launch",
      "module": "goatlib.tasks.sync_windmill",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "uv-sync",
      "presentation": {
        "hidden": false,
        "group": "tools",
        "order": 5
      }
    }
  ],
  "compounds": [
    {
      "name": "Launch App",
      "configurations": [
        "GeoAPI Debug",
        "Processes Debug",
        "Core Debug",
        "Web Debug",
        "Catalog Debug"
      ],
      "presentation": {
        "hidden": false,
        "group": "compounds",
        "order": 1
      }
    },
    {
      "name": "Backend Debug",
      "configurations": [
        "GeoAPI Debug",
        "Core Debug"
      ],
      "presentation": {
        "hidden": false,
        "group": "compounds",
        "order": 1
      }
    },
    {
      "name": "Launch App (tmux)",
      "configurations": [
        "GeoAPI (tmux)",
        "Processes (tmux)",
        "Core (tmux)",
        "Web (tmux)"
      ],
      "presentation": {
        "hidden": false,
        "group": "compounds",
        "order": 2
      }
    }
  ]
}