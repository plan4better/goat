# Test fixtures — not needed at runtime, ~110MB in goatlib alone
packages/python/*/tests
packages/cpp/*/tests
apps/catalog/tests
apps/core/tests
apps/geoapi/tests
apps/processes/tests
apps/assistant/tests
# The eval set and the end-to-end fake run from a source checkout only.
apps/assistant/evals
apps/assistant/e2e

# The worker image definition. The processes image copies apps/processes, so
# without this every change to the worker Dockerfile rebuilt the processes
# image. BuildKit still reads a Dockerfile that is ignored here.
apps/processes/workers
# ...except the print worker's fontconfig file, which worker-print copies in.
!apps/processes/workers/fonts

# Large data directories
data/
lint-results/

.git
